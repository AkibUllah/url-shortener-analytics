# Copy to .env and adjust. All variables are prefixed with SHORTENER_.
SHORTENER_BASE_URL=http://localhost:8000
SHORTENER_DATABASE_URL=sqlite:///./shortener.db
# Postgres example (used by docker-compose):
# SHORTENER_DATABASE_URL=postgresql+psycopg://shortener:shortener@db:5432/shortener

# Leave empty to use the in-process memory cache / rate limiter.
SHORTENER_REDIS_URL=redis://localhost:6379/0

# Required for management endpoints (create/list/delete/analytics). Change this.
SHORTENER_API_KEY=dev-api-key-change-me

# Secret used to hash client IPs before they are stored with click events.
SHORTENER_IP_HASH_SECRET=change-me-too

SHORTENER_RATE_LIMIT_PER_MINUTE=60
SHORTENER_CACHE_TTL_SECONDS=3600
SHORTENER_MIN_CODE_LENGTH=6
SHORTENER_LOG_LEVEL=INFO
